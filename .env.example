NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Safe for the browser: use the project's Publishable key (legacy anon key also works).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# Server-only: use the project's Secret key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your-project-key
# Legacy projects may use these names instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin Basic Auth allowlist (comma-separated emails or a JSON array) and password.
# Keep these server-only, use a strong password, and serve /admin over HTTPS.
ADMIN_EMAILS=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
